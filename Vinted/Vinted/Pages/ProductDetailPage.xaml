<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Vinted.Pages.ProductDetailPage"
             Title="ProductDetailPage"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="20">
            <CollectionView x:Name="PhotosCollectionView"
                ItemsSource="{Binding Photos}"
                HeightRequest="150"
                HorizontalScrollBarVisibility="Always"
                ItemsLayout="HorizontalList">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="5"
                            Margin="5"
                            HasShadow="True"
                            WidthRequest="120"
                            HeightRequest="120">
                            <Image Source="{Binding}"
                               Aspect="AspectFill"
                               HeightRequest="120"
                               WidthRequest="120"/>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="{Binding Name}" 
               FontSize="Large" 
               FontAttributes="Bold" 
               Margin="0,10"/>

            <Label Text="Cena"
                FontSize="Caption"
                   Margin="0,5,0,0"/>

            <Label Text="{Binding Price}" 
               FontSize="Medium"/>

            <Label Text="Opis"
                   FontSize="Caption"
                   Margin="0,5,0,0"/>

            <Label Text="{Binding Description}"/>

            <Label Text="Płeć"
                FontSize="Caption"
                   Margin="0,5,0,0"/>
            
            <Label Text="{Binding Gender}"/>

            <Label Text="Stan"
                FontSize="Caption"
                   Margin="0,5,0,0"/>
            
            <Label Text="{Binding Condition}"/>

            <Button Text="Powrót"
                Clicked="BackButtonClicked"
                    Margin="0,5,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>