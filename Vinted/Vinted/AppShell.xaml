<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Vinted.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Vinted"
    xmlns:pages="clr-namespace:Vinted.Pages"
    Shell.FlyoutBehavior="Disabled"
    Title="Vinted"
    Shell.TabBarForegroundColor="Black"
    Shell.TabBarTitleColor="Black"
    Shell.TabBarUnselectedColor="Grey">

    <TabBar>
        <ShellContent Title="Główna"
                Icon="navbar/home.png"
                ContentTemplate="{DataTemplate pages:MainPage}" />

        <ShellContent Title="Szafka"
                Icon="navbar/clotheshanger.png"
                ContentTemplate="{DataTemplate pages:WardrobePage}"/>

        <ShellContent Title="Sprzedaj"
                Icon="navbar/add.png"
                ContentTemplate="{DataTemplate pages:SellItemPage}"/>

        <ShellContent Title="Wiadomości"
                Icon="navbar/envelope.png"
                ContentTemplate="{DataTemplate pages:Messages}"/>

        <ShellContent Title="Profil"
                Icon="navbar/user.png"
                ContentTemplate="{DataTemplate pages:login}"/>
    </TabBar>
</Shell>
